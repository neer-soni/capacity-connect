# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Media uploads (local dev storage — never commit real uploads)
/public/uploads/videos/
/public/uploads/documents/
/public/uploads/images/

# Keep .env.example committed, but not .env (which has secrets)
!.env.example

# SQLite dev database (no longer used after PostgreSQL migration)
prisma/*.db
prisma/*.db-journal
