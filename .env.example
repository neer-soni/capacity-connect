# Environment Variables for Capacity Connect
# Copy this file to .env and fill in your values

# ─── Database (PostgreSQL) ────────────────────────────────────────
# Option 1: Supabase (recommended) — find this in: Project Settings > Database > Connection String > URI
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Option 2: Neon (free tier)
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DBNAME]?sslmode=require"

# Option 3: Local PostgreSQL
# DATABASE_URL="postgresql://postgres:password@localhost:5432/capacity_connect"

DATABASE_URL="postgresql://postgres:password@localhost:5432/capacity_connect"

# ─── Auth ────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="capacity-connect-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── Media Uploads ───────────────────────────────────────────────
# Max file sizes (in bytes):
#   UPLOAD_MAX_VIDEO_SIZE   = 250MB default
#   UPLOAD_MAX_DOC_SIZE     = 50MB default
#   UPLOAD_MAX_IMAGE_SIZE   = 5MB default
UPLOAD_MAX_VIDEO_SIZE=262144000
UPLOAD_MAX_DOC_SIZE=52428800
UPLOAD_MAX_IMAGE_SIZE=5242880

# Upload storage: "local" stores files in /public/uploads (dev only)
# For production, set to "cloud" and configure a cloud provider below
UPLOAD_STORAGE="local"

# ─── Cloud Storage (Optional — for production) ───────────────────
# UploadThing (easiest Next.js integration)
# UPLOADTHING_TOKEN=""

# Cloudinary (great for video transcoding)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# AWS S3
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET=""
