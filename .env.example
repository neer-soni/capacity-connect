# Environment Variables for Capacity Connect
# Copy this file to .env and fill in your values

# ─── Database (PostgreSQL) ────────────────────────────────────────
# Option 1: Supabase (recommended) — find this in: Project Settings > Database > Connection String > URI
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Option 2: Neon (free tier)
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DBNAME]?sslmode=require"

# Option 3: Local PostgreSQL
# DATABASE_URL="postgresql://postgres:password@localhost:5432/capacity_connect"

DATABASE_URL="postgresql://postgres:password@localhost:5432/capacity_connect"

# ─── Auth ────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET="capacity-connect-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── Media Uploads ───────────────────────────────────────────────
# Max file sizes (in bytes):
#   UPLOAD_MAX_VIDEO_SIZE   = 250MB default
#   UPLOAD_MAX_DOC_SIZE     = 50MB default
#   UPLOAD_MAX_IMAGE_SIZE   = 5MB default
UPLOAD_MAX_VIDEO_SIZE=262144000
UPLOAD_MAX_DOC_SIZE=52428800
UPLOAD_MAX_IMAGE_SIZE=5242880

# Upload storage: "local" for dev, or "cloud" (Supabase Storage) for production
UPLOAD_STORAGE="local"

# ─── Supabase Storage (Recommended for Vercel production) ────────
# Find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="course-media"

# ─── Other Cloud Storage Providers (Optional) ────────────────────
# UploadThing
# UPLOADTHING_TOKEN=""

# Cloudinary
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

